# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meetings_db

# Redis Cache / Status Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection
GROQ_MODEL=llama-3.3-70b-versatile

# Storage & Upload Configuration
STORAGE_DIR=./storage/audio
MAX_FILE_SIZE_MB=25

# Mock Services for offline development / test pipeline (true / false)
MOCK_SERVICES=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,http://localhost:3000
